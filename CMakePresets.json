{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows MSVC (static)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/desktop-msvc",
      "toolchainFile": "E:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_MANIFEST_MODE": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      },
      "environment": {
        "VCPKG_ROOT": "E:/vcpkg"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Linux Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-ninja-tsan",
      "displayName": "Linux Ninja Debug + ThreadSanitizer",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/desktop-linux-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CUBATARIUM_ENABLE_TSAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "linux-ninja-debug",
      "configurePreset": "linux-ninja"
    },
    {
      "name": "linux-ninja-release",
      "configurePreset": "linux-ninja-release"
    },
    {
      "name": "linux-ninja-tsan",
      "configurePreset": "linux-ninja-tsan"
    }
  ]
}
