# Copy to platforms/android/keystore.properties (gitignored) and fill in values.
# Generate upload keystore:
#   ..\..\scripts\android\setup-release-keystore.ps1
# Or manually:
#   keytool -genkeypair -v -keystore cubatarium-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Use UTF-8 without BOM when saving keystore.properties (PowerShell Set-Content adds BOM and breaks Gradle).

storeFile=cubatarium-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
