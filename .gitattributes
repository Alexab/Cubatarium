# Stable CRLF on Windows РІР‚вЂќ avoids agent/IDE line-ending flips forcing recompiles.
* text=auto eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.hpp text eol=crlf
*.c text eol=crlf
*.cmake text eol=crlf
*.md text eol=lf
*.json text eol=crlf
*.jsonl text eol=lf
*.sh text eol=lf

# Creature release provenance hashes exact bytes; preserve generated payloads and evidence.
/models/creatures/** -text
/models/creatures/_sources/** text eol=crlf
/models/skins/** -text
/docs/research/creature*/** -text
/tools/creaturegen/*.py -text
/tools/creature_recipes/*.yaml -text
/LICENSE -text
/tools/creature_palettes.yaml -text
/tools/requirements-creaturegen.txt -text
# Item manual-import evidence records exact payload bytes, including source license text.
/docs/research/item-visual-redesign-2026-11-14/manual-checkpoint/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
