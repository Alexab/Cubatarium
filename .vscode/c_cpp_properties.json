{
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src",
                "E:/vcpkg/installed/x64-windows-static/include",
                "E:/vcpkg/installed/x64-windows-static/include/glm",
                "E:/vcpkg/installed/x64-windows-static/include/GLFW",
                "E:/vcpkg/installed/x64-windows-static/include/GL",
                "E:/vcpkg/installed/x64-windows-static/include/GLEW"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "WIN32",
                "_WIN32"
            ],
            "windowsSdkVersion": "10.0.19041.0",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64",
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ],
    "version": 4
}
