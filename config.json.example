        "weather": {
            "auto_change": true,
            "dry_fraction": 0.7,
            "precip_fraction": 0.3,
            "dry_clear_fraction": 0.55,
            "min_precip_minutes": 2.0,
            "min_dry_minutes": 1.0,
            "transition_seconds": 45.0,
            "episode_min_minutes": 3.0,
            "episode_max_minutes": 12.0,
