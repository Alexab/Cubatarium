    "environment": {
        "time_of_day": 0.35,
        "day_length_minutes": 10,
        "lighting": { "min_ambient": 0.12 },
        "celestial": {
            "horizon_fade": 0.15,
            "bodies": [
                {
                    "id": "sun_main",
